#pragma once
// secrets.h.example — VORLAGE. So einrichten:
//     cp src/secrets.h.example src/secrets.h     (Windows: Copy-Item)
// Dann in src/secrets.h das echte 48-Hex-Werks-Secret eintragen.
//
// HEILIG (Ticket C): src/secrets.h ist git-ignored. Das Werks-Secret kommt NIE
// ins Repo / in die Doku / in den Chat. Der Wert (BUDDY_DEVICE_FACTORY_SECRET,
// 48-char Hex) wird von CO/Ivo out-of-band geliefert und muss exakt dem
// BUDDY_DEVICE_FACTORY_SECRET im Server-.env entsprechen.
//
// Fehlt src/secrets.h, kompiliert die Firmware trotzdem (leeres Secret) — die
// Registrierung gibt dann sauber 401 "Werks-Secret falsch", kein Crash.
#define BUDDY_DEVICE_FACTORY_SECRET "PUT_48_HEX_FACTORY_SECRET_HERE"
